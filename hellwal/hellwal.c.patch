+/* 
+ * write generated template to dir (named after the template),
+ * returns 1 on success
+ */
+size_t template_write(TEMPLATE *t, char *dir)
+{
+    if (t == NULL || dir == NULL) return 0;
+    if (t->content == NULL) return 0;
+
+    char *path = join_path(dir, t->name);
+    size_t ok = template_write_to(t, path);
+    free(path);
+
+    return ok;
+}
