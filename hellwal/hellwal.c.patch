+/* returns the basename of a path (trailing slashes ignored) */
+static char *file_basename(const char *path)
+{
+    if (path == NULL) return NULL;
+    size_t len = strlen(path);
+    while (len > 1 && path[len - 1] == '/') len--;
+    const char *base = path;
+    for (size_t i = 0; i < len; i++)
+        if (path[i] == '/') base = path + i + 1;
+    size_t blen = len - (size_t)(base - path);
+    char *out = malloc(blen + 1);
+    if (out == NULL) err("Failed to allocate memory for filename");
+    memcpy(out, base, blen);
+    out[blen] = '\0';
+    return out;
+}
+
+/* trim leading/trailing whitespace in place, returns the string */
+static char *trim_ws(char *s)
+{
+    if (s == NULL) return s;
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    size_t len = strlen(s);
+    while (len > 0 && (s[len - 1] == ' ' || s[len - 1] == '\t' ||
+                       s[len - 1] == '\r' || s[len - 1] == '\n'))
+        s[--len] = '\0';
+    return s;
+}
+
+/* append one parsed mapping to CONF, freeing any stale partial entry */
+static void template_config_commit(char **name, char **output)
+{
+    char *n = *name;
+    char *o = *output;
+    if (n == NULL && o == NULL) return;
+    if (n == NULL || o == NULL)
+    {
+        free(n);
+        free(o);
+        *name = NULL;
+        *output = NULL;
+        return;
+    }
+    CONF = realloc(CONF, (CONF_COUNT + 1) * sizeof(TEMPLATE_CONF));
+    if (CONF == NULL) err("Failed to allocate memory for template config");
+    CONF[CONF_COUNT].template_name = n;
+    CONF[CONF_COUNT].output_path = o;
+    CONF_COUNT++;
+    *name = NULL;
+    *output = NULL;
+}
+
+/*
+ * Parse ~/.config/hellwal/config.toml (or --config path). A small TOML subset:
+ *   [templates.NAME]
+ *   input_path  = "..."
+ *   output_path = "..."
+ * If input_path is omitted, the section name ("NAME") is used to match
+ * template filenames. If the file is missing, templates keep writing to the
+ * default output folder.
+ */
+void load_template_config(void)
+{
+    static int loaded = 0;
+    if (loaded) return;
+    loaded = 1;
+
+    if (CONF_FILE == NULL) return;
+
+    FILE *f = fopen(CONF_FILE, "r");
+    if (f == NULL) return; /* no config file -> previous behavior */
+
+    char line[1024];
+    char *name = NULL;
+    char *output = NULL;
+
+    while (fgets(line, sizeof(line), f) != NULL)
+    {
+        char *s = trim_ws(line);
+        if (*s == '\0' || *s == '#') continue;
+
+        if (*s == '[')
+        {
+            template_config_commit(&name, &output);
+            char *end = strchr(s, ']');
+            if (end == NULL) continue;
+            *end = '\0';
+            char *sec = trim_ws(s + 1);
+            char *dot = strstr(sec, "templates.");
+            if (dot != NULL) sec = dot + strlen("templates.");
+            name = strdup(trim_ws(sec));
+            continue;
+        }
+
+        char *eq = strchr(s, '=');
+        if (eq == NULL) continue;
+        *eq = '\0';
+        char *key = trim_ws(s);
+        char *val = trim_ws(eq + 1);
+        size_t vlen = strlen(val);
+        if (vlen >= 2 && ((val[0] == '"' && val[vlen - 1] == '"') ||
+                          (val[0] == '\'' && val[vlen - 1] == '\'')))
+        {
+            val[vlen - 1] = '\0';
+            val++;
+        }
+
+        if (strcmp(key, "input_path") == 0)
+        {
+            free(name);
+            name = file_basename(val);
+        }
+        else if (strcmp(key, "output_path") == 0)
+        {
+            char *full = home_full_path(val);
+            free(output);
+            output = full;
+        }
+    }
+
+    template_config_commit(&name, &output);
+    fclose(f);
+}
+
+/* find configured output path for a template by its filename */
+const char *template_config_output(const char *template_name)
+{
+    if (template_name == NULL) return NULL;
+    for (size_t i = 0; i < CONF_COUNT; i++)
+        if (CONF[i].template_name && strcmp(CONF[i].template_name, template_name) == 0)
+            return CONF[i].output_path;
+    return NULL;
+}
