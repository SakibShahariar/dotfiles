/*
* GTK Colors
* Generated with Matugen
*/

:root {
  --primary: {{ (get . "accent1").Hex }};
  --on_primary: {{ (get . "onAccent1").Hex }};
  --primary_container: {{ (get . "accent1Muted").Hex }};
  --on_primary_container: {{ (get . "onAccent1").Hex }};
  --inverse_primary: {{ (get . "inversePrimary").Hex }};
  --primary_fixed: {{ (get . "accent1").Hex }};
  --primary_fixed_dim: {{ (get . "accent1Muted").Hex }};
  --on_primary_fixed: {{ (get . "onAccent1").Hex }};
  --on_primary_fixed_variant: {{ (get . "onAccent2").Hex }};

  --secondary: {{ (get . "accent2").Hex }};
  --on_secondary: {{ (get . "onAccent2").Hex }};
  --secondary_container: {{ (get . "accent2Muted").Hex }};
  --on_secondary_container: {{ (get . "onAccent2").Hex }};
  --secondary_fixed: {{ (get . "accent2").Hex }};
  --secondary_fixed_dim: {{ (get . "accent2Muted").Hex }};
  --on_secondary_fixed: {{ (get . "onAccent2").Hex }};
  --on_secondary_fixed_variant: {{ (get . "onAccent3").Hex }};

  --tertiary: {{ (get . "accent3").Hex }};
  --on_tertiary: {{ (get . "onAccent3").Hex }};
  --tertiary_container: {{ (get . "accent3Muted").Hex }};
  --on_tertiary_container: {{ (get . "onAccent3").Hex }};
  --tertiary_fixed: {{ (get . "accent3").Hex }};
  --tertiary_fixed_dim: {{ (get . "accent3Muted").Hex }};
  --on_tertiary_fixed: {{ (get . "onAccent3").Hex }};
  --on_tertiary_fixed_variant: {{ (get . "onAccent4").Hex }};

  --error: {{ (get . "danger").Hex }};
  --on_error: {{ (get . "onDanger").Hex }};
  --error_container: {{ (get . "surfaceContainerHigh").Hex }};
  --on_error_container: {{ (get . "onSurfaceVariant").Hex }};

  --surface_dim: {{ (get . "surfaceContainerLowest").Hex }};
  --surface: {{ (get . "surface").Hex }};
  --surface_tint: {{ (get . "accent1").Hex }};
  --surface_bright: {{ (get . "surfaceContainerHighest").Hex }};
  --surface_container_lowest: {{ (get . "surfaceContainerLowest").Hex }};
  --surface_container_low: {{ (get . "surfaceContainerLow").Hex }};
  --surface_container: {{ (get . "surfaceContainer").Hex }};
  --surface_container_high: {{ (get . "surfaceContainerHigh").Hex }};
  --surface_container_highest: {{ (get . "surfaceContainerHighest").Hex }};
  --surface_variant: {{ (get . "surfaceVariant").Hex }};
  --on_surface: {{ (get . "onSurface").Hex }};
  --on_surface_variant: {{ (get . "onSurfaceVariant").Hex }};

  --outline: {{ (get . "outline").Hex }};
  --outline_variant: {{ (get . "outlineVariant").Hex }};

  --inverse_surface: {{ (get . "inverseSurface").Hex }};
  --inverse_on_surface: {{ (get . "inverseOnSurface").Hex }};

  --background: {{ (get . "background").Hex }};
  --on_background: {{ (get . "foreground").Hex }};

  --shadow: {{ (get . "shadow").Hex }};
  --scrim: {{ (get . "scrim").Hex }};
  --source_color: {{ (get . "accent1").Hex }};
  
  --shade-color: rgb({{ (get . "surface").R }} {{ (get . "surface").G }} {{ (get . "surface").B }} / 25%);
}

/* Core Theme Colors */
@define-color theme_fg_color {{ (get . "onSurface").Hex }};
