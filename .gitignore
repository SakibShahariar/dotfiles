# Fish shell: ignore auto-generated variable state
fish/.config/fish/fish_variables

# Kitty: ignore custom color theme file
kitty/.config/kitty/colors.conf

# Micro editor: ignore temp data and personal color scheme
micro/.config/micro/backups/
micro/.config/micro/buffers/
micro/.config/micro/colorschemes/colors.micro

# Qt5ct/Qt6ct: matugen-generated theme, let it regenerate
qt5ct/.config/qt5ct/colors.conf
qt6ct/.config/qt6ct/colors.conf
qt5ct/.config/qt5ct/qt5ct.conf
qt6ct/.config/qt6ct/qt6ct.conf

# VLC: ignore user interface layout/config
vlc/.config/vlc/vlc-qt-interface.conf

lumo/.config/lumo/logs/

mpv/.config/mpv/script-opts/uosc.conf

walker/.config/walker/themes/hellwal.css
