color-link default "#D5C4A1"
color-link comment "#928374"

color-link identifier "#E4B5FF"
color-link identifier.class "#89b4fa"
color-link identifier.var "#89b4fa"

color-link constant "#4F4255"
color-link constant.string "#331013"

color-link symbol "#7DAEA3"

color-link type "#B5E9DC"
color-link type.keyword "#f9e2af"

color-link special "#331013"
color-link statement "#7DAEA3"
color-link preproc "#A89984"

color-link underlined "#E4B5FF"
color-link error "bold #FB4934"
color-link todo "bold #E4B5FF"

color-link diff-added "#5C8C84"
color-link diff-modified "#E4B5FF"
color-link diff-deleted "#FB4934"

color-link gutter-error "#FB4934"
color-link gutter-warning "#B5E9DC"

color-link statusline "#331013"
color-link tabbar "#1D2021,#D5C4A1"
color-link indent-char "#474747"
color-link line-number "#474747"
color-link current-line-number "#7DAEA3"

color-link cursor-line "#32302F,#cdd6f4"
color-link color-column "#32302F"
color-link type.extended "default"

color-link hlsearch "#000000"

color-link match-brace "#7DAEA3,#B5E9DC"

color-link tab-error "#FB4934"
color-link trailingws "#FB4934"

