#!/usr/bin/env python3
import sys
import asyncio
import runpy

# Python 3.14 fix: explicitly create an event loop
asyncio.set_event_loop(asyncio.new_event_loop())

# Forward CLI arguments to spotdl
sys.argv = ["spotdl", "--output", "/home/sakib/Music"] + sys.argv[1:]

# Run spotdl as a module
runpy.run_module("spotdl", run_name="__main__")
