# Base colors using dark MD3 scheme
color-link default "#e9dfee"
color-link comment "#968e9b"

# Identifiers - using primary colors
color-link identifier "#d8b9ff"
color-link identifier.class "#6300bb"
color-link identifier.var "#d8b9ff"

# Constants - using surface variants
color-link constant "#f7d9ff"
color-link constant.string "#e9dfee"

# Symbols and statements - using secondary colors
color-link symbol "#dabde2"
color-link statement "#d8b9ff"

# Types - using tertiary colors
color-link type "#e9dfee"
color-link type.keyword "#eab6e4"

# Special and preprocessor
color-link special "#e9dfee"
color-link preproc "#ccc3d2"

# UI Elements
color-link underlined "#d8b9ff"
color-link error "bold #ffb4ab"
color-link todo "bold #d8b9ff"

# Diff colors
color-link diff-added "#eab6e4"
color-link diff-modified "#6300bb"
color-link diff-deleted "#ffb4ab"

# Gutter and line numbers
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#e9dfee"
color-link line-number "#968e9b"
color-link current-line-number "#d8b9ff"
color-link indent-char "#968e9b"

# Interface colors (using your dark surfaces)
color-link cursor-line "#2d2833,#e9dfee"
color-link color-column "#2d2833"
color-link statusline "#e9dfee"
color-link tabbar "#16111b,#38333e"

# Search and matching
color-link hlsearch "#e9dfee"
color-link match-brace "#d8b9ff,#16111b"

# Whitespace and errors
color-link tab-error "#ffb4ab"
color-link trailingws "#ffb4ab"

# Background and selection
color-link background "#16111b"
color-link selected "#38333e"
