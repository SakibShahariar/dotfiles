# Base colors using dark MD3 scheme
color-link default "#f3ded7"
color-link comment "#a58b81"

# Identifiers - using primary colors
color-link identifier "#ffb695"
color-link identifier.class "#e17138"
color-link identifier.var "#ffb695"

# Constants - using surface variants
color-link constant "#ffd8c8"
color-link constant.string "#f3ded7"

# Symbols and statements - using secondary colors
color-link symbol "#fcb798"
color-link statement "#ffb695"

# Types - using tertiary colors
color-link type "#f3ded7"
color-link type.keyword "#6bd3fd"

# Special and preprocessor
color-link special "#f3ded7"
color-link preproc "#ddc1b5"

# UI Elements
color-link underlined "#ffb695"
color-link error "bold #ffb4ab"
color-link todo "bold #ffb695"

# Diff colors
color-link diff-added "#6bd3fd"
color-link diff-modified "#e17138"
color-link diff-deleted "#ffb4ab"

# Gutter and line numbers
color-link gutter-error "#ffb4ab"
color-link gutter-warning "#f3ded7"
color-link line-number "#a58b81"
color-link current-line-number "#ffb695"
color-link indent-char "#a58b81"

# Interface colors (using your dark surfaces)
color-link cursor-line "#332723,#f3ded7"
color-link color-column "#332723"
color-link statusline "#f3ded7"
color-link tabbar "#1b110d,#3e322d"

# Search and matching
color-link hlsearch "#f3ded7"
color-link match-brace "#ffb695,#1b110d"

# Whitespace and errors
color-link tab-error "#ffb4ab"
color-link trailingws "#ffb4ab"

# Background and selection
color-link background "#1b110d"
color-link selected "#3e322d"
